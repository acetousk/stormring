[node name="Storm" type="Node3D" parent="."]
script = ExtResource("5_storm")

[node name="Wall" type="MeshInstance3D" parent="Storm"]
mesh = SubResource("storm_mesh")
cast_shadow = 0

[node name="StormSync" type="Node" parent="Storm"]
script = ExtResource("6_sync")
refresh_rate = 5
node_path = NodePath("..")
properties = PackedStringArray("center", "time")
interpolated = true
interpolation_speed = 5.0

[node name="HUD" parent="." instance=ExtResource("3_hud")]
