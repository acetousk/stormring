]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":true,"script":null)
]
}
