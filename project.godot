; Engine configuration file.
config_version=5

[application]

config/name="Stormring"
config/version="0.2.2"
run/main_scene="res://scenes/lobby.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GDSync="*res://addons/GD-Sync/MultiplayerClient.gd"
Tune="*res://scripts/tune.gd"
Net="*res://scripts/net.gd"
Sfx="*res://scripts/sfx.gd"


[editor_plugins]

enabled=PackedStringArray("res://addons/GD-Sync/plugin.cfg")

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0,"script":null)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0,"script":null)
]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0,"script":null)
]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0,"script":null)
]
}
